# ==============================================================================
# DataForge AI - Environment Configuration Example
# Copy this file to .env (or backend/.env and frontend/.env) to configure.
# ==============================================================================

# Backend Server Configuration
HOST=127.0.0.1
PORT=8080
RELOAD=true
LOG_LEVEL=info

# Cross-Origin Resource Sharing (CORS) - Comma-separated allowed origins
# For development: http://localhost:3000,http://127.0.0.1:3000
# For production: https://your-production-domain.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend API Configuration
# Leave blank for local development using the Vite reverse proxy (/api)
# Set to full URL if hosting backend on another domain/port (e.g., https://api.yourdomain.com)
VITE_API_BASE_URL=
